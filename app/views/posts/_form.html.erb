<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: #e74c3c; padding: 1rem; border: 1px solid #e74c3c; border-radius: 4px; margin-bottom: 2rem;">
      <h2><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 1.5rem;">
    <%= form.label :title, style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
    <%= form.text_field :title, style: "width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1.5rem;">
    <%= form.label :content, style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
    <%= form.text_area :content, rows: 5, style: "width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div>
    <%= form.submit class: "button", style: "cursor: pointer; border: none;" %>
  </div>
<% end %>
