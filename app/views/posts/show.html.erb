<% content_for :title, @post.title %>

<% if notice %>
  <div class="notice"><%= notice %></div>
<% end %>

<div class="post" style="margin: 2rem 0;">
  <h1><%= @post.title %></h1>
  
  <div class="post-content">
    <%= @post.content %>
  </div>

  <div class="post-actions">
    <%= link_to "Edit", edit_post_path(@post), class: "button" %>
    <%= link_to "Back", posts_path, class: "button" %>
    <%= button_to "Delete", @post, method: :delete, class: "button danger", form: { style: 'display: inline-block' }, data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
